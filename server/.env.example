# The address people's links will use (its DNS must point at this machine for HTTPS).
OPENNEXUS_DOMAIN=share.example.com
# The app's destination uses this. Make one with: openssl rand -base64 32
OPENNEXUS_UPLOAD_TOKEN=
# Optional: the longest a share may live, in days (0 = as long as the link says).
OPENNEXUS_MAX_DAYS=0
