{
  "$defs": {
    "asset": {
      "description": "A file stored once in the package by content hash.",
      "properties": {
        "asset": {
          "description": "Path inside the package, assets/<sha256>.<ext>.",
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "boundary": {
      "description": "Encloses one or more branches.",
      "properties": {
        "color": {
          "type": "string"
        },
        "dash": {
          "type": "string"
        },
        "fillOpacity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "hatch": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "meaning": {
          "description": "group, zone, vpc, subnet or trust. Unknown values are preserved.",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "shape": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titlePosition": {
          "type": "string"
        },
        "trust": {
          "type": "string"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "nodes"
      ],
      "type": "object"
    },
    "callout": {
      "description": "A speech bubble attached to a host topic.",
      "properties": {
        "host": {
          "$ref": "#/$defs/id"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "shape": {
          "type": "string"
        },
        "side": {
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/id",
          "description": "The bubble, a node of kind callout."
        }
      },
      "required": [
        "id",
        "host",
        "topic"
      ],
      "type": "object"
    },
    "canvas": {
      "description": "One canvas (canvases/<id>.json): a graph of nodes and edges with a diagram type.",
      "properties": {
        "boundaries": {
          "items": {
            "$ref": "#/$defs/boundary"
          },
          "type": "array"
        },
        "callouts": {
          "items": {
            "$ref": "#/$defs/callout"
          },
          "type": "array"
        },
        "floating": {
          "description": "Ids of floating topics (not attached to the root tree), in z-order.",
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "layout": {
          "properties": {
            "allowOverlap": {
              "type": "boolean"
            },
            "branchFreePositioning": {
              "type": "boolean"
            },
            "flexibleFloating": {
              "type": "boolean"
            },
            "mode": {
              "description": "auto (default) or free (opt-in per canvas).",
              "type": "string"
            },
            "structure": {
              "description": "family.variant, for example mindmap.balanced or logic.right.",
              "pattern": "^[A-Za-z]+(\\.[A-Za-z]+)?$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "nodes": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/$defs/node"
            }
          },
          "type": "object"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "type": "array"
        },
        "root": {
          "$ref": "#/$defs/id"
        },
        "style": {
          "properties": {
            "autoBalance": {
              "type": "boolean"
            },
            "background": {
              "type": "string"
            },
            "cjkFont": {
              "type": "string"
            },
            "colorTheme": {
              "type": "string"
            },
            "coloredBranch": {
              "type": "boolean"
            },
            "compact": {
              "type": "boolean"
            },
            "font": {
              "type": "string"
            },
            "justify": {
              "type": "boolean"
            },
            "levels": {
              "description": "Per-level topic style overrides keyed by depth.",
              "type": "object"
            },
            "lineShape": {
              "type": "string"
            },
            "lineWidth": {
              "type": "number"
            },
            "nodeStyle": {
              "type": "string"
            },
            "palette": {
              "type": "string"
            },
            "paletteShift": {
              "minimum": 0,
              "type": "integer"
            },
            "pattern": {
              "type": "string"
            },
            "singleColor": {
              "type": "string"
            },
            "theme": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "summaries": {
          "items": {
            "$ref": "#/$defs/summary"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "description": "Diagram type: mindmap, logic, brace, org, tree, treeTable, timeline, fishbone, matrix, flowchart, swimlane, dfd, threatModel, architecture, sequence, whiteboard. Unknown values are preserved.",
          "minLength": 1,
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/zone"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "nodes",
        "root",
        "type"
      ],
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "manifest": {
      "description": "manifest.json at the root of a .nexus package.",
      "properties": {
        "app": {
          "description": "Version of the app that last wrote the file.",
          "type": "string"
        },
        "canvases": {
          "description": "Canvas ids in tab order. Each has a canvases/<id>.json file.",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "encrypted": {
          "type": "boolean"
        },
        "format": {
          "const": "opennexus"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "canvases",
        "format",
        "schemaVersion"
      ],
      "type": "object"
    },
    "node": {
      "properties": {
        "ai": {
          "description": "Created by AI and not yet edited by the user.",
          "type": "boolean"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/asset"
          },
          "type": "array"
        },
        "audio": {
          "properties": {
            "asset": {
              "type": "string"
            },
            "duration": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "asset"
          ],
          "type": "object"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "folded": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/asset"
        },
        "kind": {
          "description": "root, topic, floating, summary or callout. Unknown values are preserved.",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "link": {
          "type": "string"
        },
        "markers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "marks": {
          "items": {
            "$ref": "#/$defs/textMark"
          },
          "type": "array"
        },
        "metadata": {
          "items": {
            "properties": {
              "key": {
                "type": "string"
              },
              "pinned": {
                "type": "boolean"
              },
              "value": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "note": {
          "properties": {
            "format": {
              "enum": [
                "md",
                "plain"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "quickStyle": {
          "type": "string"
        },
        "sticker": {
          "type": "string"
        },
        "structure": {
          "type": "string"
        },
        "style": {
          "type": "object"
        },
        "text": {
          "type": "string"
        },
        "todo": {
          "properties": {
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "done"
          ],
          "type": "object"
        }
      },
      "required": [
        "children",
        "kind",
        "text"
      ],
      "type": "object"
    },
    "point": {
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "relationship": {
      "properties": {
        "bend": {
          "$ref": "#/$defs/point"
        },
        "color": {
          "description": "theme, source or a #RRGGBB colour.",
          "type": "string"
        },
        "dash": {
          "type": "string"
        },
        "ends": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "description": "Technical edge type, for example dataflow or call. Unknown values are preserved.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "labelPosition": {
          "type": "string"
        },
        "labelStyle": {
          "type": "string"
        },
        "line": {
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "width": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "from",
        "id",
        "to"
      ],
      "type": "object"
    },
    "summary": {
      "description": "A bracket over a contiguous sibling range with its own topic.",
      "properties": {
        "bracket": {
          "description": "curly (default), square, round or line. Unknown values draw as curly.",
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "topic": {
          "$ref": "#/$defs/id",
          "description": "The summary topic, a node of kind summary."
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "parent",
        "from",
        "to",
        "topic"
      ],
      "type": "object"
    },
    "textMark": {
      "description": "A rich-text run over a topic's text, in UTF-16 offsets.",
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "length": {
          "minimum": 1,
          "type": "integer"
        },
        "link": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "length"
      ],
      "type": "object"
    },
    "theme": {
      "description": "theme.json: document theme, custom colour themes and quick styles.",
      "type": "object"
    },
    "zone": {
      "description": "A titled free-standing area on the canvas, in z-order.",
      "properties": {
        "autoResize": {
          "type": "boolean"
        },
        "collapsed": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "frame": {
          "type": "string"
        },
        "height": {
          "minimum": 100,
          "type": "number"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "members": {
          "description": "Floating topics inside the zone; they move with it.",
          "items": {
            "$ref": "#/$defs/id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "title": {
          "type": "string"
        },
        "width": {
          "minimum": 100,
          "type": "number"
        }
      },
      "required": [
        "id",
        "origin",
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$id": "https://opennexus.app/schema/nexus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/canvas"
    }
  ],
  "description": "OpenNexus .nexus package files. Objects allow unknown keys so newer files round-trip through older apps.",
  "title": "OpenNexus document"
}
