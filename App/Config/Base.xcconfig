// Shared by every target. Builds are signed ad hoc unless Signing.local.xcconfig (not in
// Git) names a team. With a team, the App Group `<TeamID>.com.opennexus` works without a
// provisioning profile, so widgets, Handoff and the extensions' hand-off work (D115).
//
// To sign with your team, create App/Config/Signing.local.xcconfig:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
