<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local and owned: sandboxed, no network entitlement, user-selected files only. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Map Shot's save folder (Settings › Export) is remembered as a security-scoped bookmark. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Audio notes (M3) record locally to the package's assets/. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
