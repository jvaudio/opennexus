{
  "name": "opennexus-web",
  "private": true,
  "description": "OpenNexus in the browser: the interactive viewer (M43) and what grows from it.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "viewer-core"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w viewer-core",
    "fixtures": "cd .. && NEXUS_WRITE_VIEWER_FIXTURES=1 swift test --filter ViewerFixtures",
    "typecheck": "tsc -p viewer-core --noEmit && tsc -p e2e --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run fixtures && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
