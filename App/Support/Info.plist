<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OpenNexus Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.opennexus.document</string>
			</array>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>NSDocumentClass</key>
			<string>$(PRODUCT_MODULE_NAME).NexusDocument</string>
			<key>NSUbiquitousDocumentUserActivityType</key>
			<string>com.opennexus.document.editing</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OpenNexus Document (Single JSON)</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.opennexus.json-document</string>
			</array>
			<key>NSDocumentClass</key>
			<string>$(PRODUCT_MODULE_NAME).NexusDocument</string>
		</dict>
	</array>
	<!-- M9: the App Group shared with the extensions and the embedded `nexus` tool. -->
	<key>OpenNexusAppGroup</key>
	<string>$(TeamIdentifierPrefix)com.opennexus</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.opennexus.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>opennexus</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.opennexus.document.editing</string>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New OpenNexus Map from Selection</string>
			</dict>
			<key>NSMessage</key>
			<string>newMapFromSelection</string>
			<key>NSPortName</key>
			<string>OpenNexus</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to OpenNexus Inbox</string>
			</dict>
			<key>NSMessage</key>
			<string>addSelectionToInbox</string>
			<key>NSPortName</key>
			<string>OpenNexus</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.composite-content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>OpenNexus Document</string>
			<key>UTTypeIdentifier</key>
			<string>com.opennexus.document</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nexus</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>OpenNexus Document (Single JSON)</string>
			<key>UTTypeIdentifier</key>
			<string>com.opennexus.json-document</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>nexusjson</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
